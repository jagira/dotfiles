// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "colorize_brackets": true,
  "confirm_quit": true,
  // Auto Update
  "status_bar": {
    "show_active_file": false
  },
  "auto_update": false,
  // Editor
  "tab_size": 2,
  "buffer_font_size": 15,
  "buffer_font_fallbacks": [
    "Symbols Nerd Font"
  ],
  "ui_font_size": 16,
  // Theme
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  // Keymap
  "base_keymap": "VSCode",
  "vim_mode": false,
  // Language Servers
  // Disabled globally — only enabled per language below
  "enable_language_server": false,
  "languages": {
    "Ruby": {
      "enable_language_server": true,
      "language_servers": [
        "rubocop"
      ]
    },
    "JSON": {
      "enable_language_server": true
    },
    "JSONC": {
      "enable_language_server": true
    }
  },
  // Extensions
  // LSPs bundled with these extensions are blocked by "enable_language_server": false
  "auto_install_extensions": {
    "html": true,
    "ruby": true,
    "scss": true,
    "git-firefly": true
  },
  // Formatting
  "prettier": {
    "allowed": false
  },
  "completions": {
    "lsp": false
  },
  // Terminal
  "terminal": {
    "dock": "left",
    "default_width": 9999
  },
  // UI Panels
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "right"
  },
  "title_bar": {
    "show_branch_name": true,
    "show_user_menu": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_status_icon": true,
    "show_sign_in": false
  },
  "collaboration_panel": {
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "outline_panel": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  // Privacy
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
